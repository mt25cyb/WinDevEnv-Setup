  "symlinks": [
    {
      "id": "vscode-userdata",
      "switchKey": "ENABLE_VSCODE_PORTABLE",
      "source": "./profiles/vscode/user-data",
      "target": "%APPDATA%\\Code",
      "isFile": false
    },
    {
      "id": "vscode-extensions",
      "switchKey": "ENABLE_VSCODE_PORTABLE",
      "source": "./profiles/vscode/extensions",
      "target": "%USERPROFILE%\\.vscode\\extensions",
      "isFile": false
    },
    {
      "id": "vscode-shared",
      "switchKey": "ENABLE_VSCODE_PORTABLE",
      "source": "./profiles/vscode/shared-data",
      "target": "%USERPROFILE%\\.vscode-shared",
      "isFile": false
    },
    {
      "id": "omp-themes",
      "switchKey": "ENABLE_OMP_THEMES_PORTABLE",
      "source": "./profiles/omp-themes",
      "target": "%USERPROFILE%\\.config\\oh-my-posh\\themes",
      "isFile": false
    },
    {
      "id": "wt-config",
      "switchKey": "ENABLE_WT_PORTABLE",
      "source": "./profiles/windows-terminal",
      "target": "%LOCALAPPDATA%\\Packages\\Microsoft.WindowsTerminal_8wekyb3d8bbwe\\LocalState",
      "isFile": false
    },
    {
      "id": "pwsh-profile-5",
      "switchKey": "ENABLE_PWSH_PROFILE_PORTABLE",
      "source": "./profiles/pwsh-data/Microsoft.PowerShell_profile_5.ps1",
      "target": "%USERPROFILE%\\Documents\\WindowsPowerShell\\Microsoft.PowerShell_profile.ps1",
      "isFile": true
    },
    {
      "id": "pwsh-profile-7",
      "switchKey": "ENABLE_PWSH_PROFILE_PORTABLE",
      "source": "./profiles/pwsh-data/Microsoft.PowerShell_profile_7.ps1",
      "target": "%USERPROFILE%\\Documents\\PowerShell\\Microsoft.PowerShell_profile.ps1",
      "isFile": true
    }
  ],
  "paths": {
    "logDir": "./logs",
    "profileDir": "./profiles",
    "assetsDir": "./wde-assets"
  }
}
