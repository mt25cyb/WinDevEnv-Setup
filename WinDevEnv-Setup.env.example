# ==============================================
# WinDevEnv-Setup 环境配置模板
# 首次运行自动复制为 WinDevEnv-Setup.env
# ==============================================

# ========== 软件安装开关 ==========
# 开发工具
ENABLE_GIT=true
ENABLE_NODEJS=true
ENABLE_PYTHON=true
ENABLE_POWERSHELL7=true
ENABLE_VSCODE=true
ENABLE_WINDOWS_TERMINAL=true
ENABLE_OH_MY_POSH=true

# 容器组件（默认关闭）
ENABLE_WSL2=false
ENABLE_DOCKER_DESKTOP=false

# ========== 软件版本配置 ==========
# 留空则自动安装最新 LTS 版本，填写版本号则安装指定版本
GIT_VERSION=
NODEJS_VERSION=
PYTHON_VERSION=
POWERSHELL7_VERSION=
VSCODE_VERSION=

# ========== 终端美化配置 ==========
# Nerd Font 字体选择：JetBrainsMono / Monaco / SourceCodePro / FiraCode / CascadiaCode / Inconsolata / UbuntuMono
OMP_FONT=JetBrainsMono
# 默认主题名
OMP_DEFAULT_THEME=jandedobbeleer

# PS模块
ENABLE_TERMINAL_ICONS=true
ENABLE_POSH_GIT=true

# ========== 便携化软链接开关 ==========
ENABLE_VSCODE_PORTABLE=true
ENABLE_OMP_THEMES_PORTABLE=true
ENABLE_WT_PORTABLE=true
ENABLE_PWSH_PROFILE_PORTABLE=true

# ========== 镜像源配置 ==========
# WinGet 源：official / ustc / cernet / nju / xjtu / nyist
WINGET_MIRROR=ustc
# GitHub 镜像：official / ghproxy / ghproxy-mirror / shturl1 / shturl2
GITHUB_MIRROR=ghproxy
# 包管理器镜像（npm/pip）
ENABLE_PKG_MIRROR=false

# ========== 日志配置 ==========
# 日志保留天数
LOG_RETENTION_DAYS=30
# 强制保留最近日志文件数
LOG_MIN_KEEP=3

# ========== 高级配置 ==========
# 是否启用开发者模式（输出更多调试信息）
ENABLE_DEV_MODE=false